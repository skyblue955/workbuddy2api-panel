diff --git a/cmd/openapi/main.go b/cmd/openapi/main.go
new file mode 100644
index 0000000..06d3bb8
--- /dev/null
+++ b/cmd/openapi/main.go
@@ -0,0 +1,115 @@
+// Command openapi exposes only the official, explicitly opted-in API actions.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"github.com/linguo2625469/workbuddy2api-panel/internal/activities"
+	"github.com/linguo2625469/workbuddy2api-panel/internal/workbuddyopen"
+)
+
+const maxInput = 64 << 10
+
+type redeemer interface {
+	Redeem(context.Context, string, workbuddyopen.RedemptionRequest) (*workbuddyopen.RedemptionResponse, error)
+}
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout, workbuddyopen.NewClient()); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdin io.Reader, out io.Writer, client redeemer) error {
+	if len(args) == 0 {
+		return errors.New("usage: openapi activities | authorize | exchange | redeem [-execute -token-file path]")
+	}
+	switch args[0] {
+	case "authorize", "exchange":
+		oauthClient, ok := client.(*workbuddyopen.Client)
+		if !ok {
+			return errors.New("oauth: client does not support authorization")
+		}
+		if args[0] == "authorize" {
+			return runAuthorize(args[1:], out, oauthClient)
+		}
+		return runExchange(args[1:], stdin, out, oauthClient)
+	case "activities":
+		fs := flag.NewFlagSet("activities", flag.ContinueOnError)
+		fs.SetOutput(io.Discard)
+		if err := fs.Parse(args[1:]); err != nil || fs.NArg() != 0 {
+			return errors.New("activities: unknown or trailing arguments")
+		}
+		return json.NewEncoder(out).Encode(activities.Registry())
+	case "redeem":
+		return runRedeem(args[1:], stdin, out, client)
+	default:
+		return fmt.Errorf("unknown subcommand %q", args[0])
+	}
+}
+
+func runRedeem(args []string, stdin io.Reader, out io.Writer, client redeemer) error {
+	fs := flag.NewFlagSet("redeem", flag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	execute := fs.Bool("execute", false, "submit the request")
+	tokenFile := fs.String("token-file", "", "official OAuth access-token JSON file")
+	if err := fs.Parse(args); err != nil || fs.NArg() != 0 {
+		return errors.New("redeem: unknown or trailing arguments")
+	}
+	input, err := decodeRequest(stdin)
+	if err != nil {
+		return err
+	}
+	if err := input.Validate(); err != nil {
+		return err
+	}
+	if !*execute {
+		if _, err := io.WriteString(out, "DRY_RUN: no network request\n"); err != nil {
+			return err
+		}
+		return nil
+	}
+	if strings.TrimSpace(*tokenFile) == "" {
+		return errors.New("redeem: -token-file is required with -execute")
+	}
+	token, err := readTokenFile(*tokenFile)
+	if err != nil {
+		return err
+	}
+	result, err := client.Redeem(context.Background(), token, input)
+	if err != nil {
+		return err
+	}
+	_, err = fmt.Fprintf(out, "{\"flow_no\":%q,\"credits\":%d}\n", result.FlowNo, result.Credits)
+	return err
+}
+
+func decodeRequest(r io.Reader) (workbuddyopen.RedemptionRequest, error) {
+	limited := io.LimitReader(r, maxInput+1)
+	data, err := io.ReadAll(limited)
+	if err != nil {
+		return workbuddyopen.RedemptionRequest{}, errors.New("redeem: input unreadable")
+	}
+	if len(data) > maxInput {
+		return workbuddyopen.RedemptionRequest{}, errors.New("redeem: input exceeds 64 KiB")
+	}
+	dec := json.NewDecoder(strings.NewReader(string(data)))
+	dec.DisallowUnknownFields()
+	var input workbuddyopen.RedemptionRequest
+	if err := dec.Decode(&input); err != nil {
+		return input, errors.New("redeem: input must be one JSON object")
+	}
+	var extra any
+	if err := dec.Decode(&extra); err != io.EOF {
+		return input, errors.New("redeem: trailing JSON is not allowed")
+	}
+	return input, nil
+}
diff --git a/cmd/openapi/main_test.go b/cmd/openapi/main_test.go
new file mode 100644
index 0000000..b99d0ff
--- /dev/null
+++ b/cmd/openapi/main_test.go
@@ -0,0 +1,71 @@
+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/linguo2625469/workbuddy2api-panel/internal/workbuddyopen"
+)
+
+type fakeRedeemer struct {
+	calls int
+	token string
+	input workbuddyopen.RedemptionRequest
+}
+
+func (f *fakeRedeemer) Redeem(_ context.Context, token string, input workbuddyopen.RedemptionRequest) (*workbuddyopen.RedemptionResponse, error) {
+	f.calls++
+	f.token, f.input = token, input
+	return &workbuddyopen.RedemptionResponse{FlowNo: "flow", Credits: 7, OpenID: "secret-open-id"}, nil
+}
+
+func TestRedeemDryRunDoesNotCallClient(t *testing.T) {
+	f := &fakeRedeemer{}
+	var out strings.Builder
+	err := run([]string{"redeem"}, strings.NewReader(`{"code":"code","request_id":"stable-1"}`), &out, f)
+	if err != nil || out.String() != "DRY_RUN: no network request\n" || f.calls != 0 {
+		t.Fatalf("err=%v out=%q calls=%d", err, out.String(), f.calls)
+	}
+}
+
+func TestRedeemExecuteReadsTokenAndDoesNotPrintSecrets(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "token.json")
+	tokenJSON := `{"access_token":"official-token","token_type":"Bearer","expires_in":3600,"scope":"user.credit.exchange","obtained_at":"` + time.Now().UTC().Format(time.RFC3339) + `"}`
+	if err := os.WriteFile(path, []byte(tokenJSON), 0600); err != nil {
+		t.Fatal(err)
+	}
+	f := &fakeRedeemer{}
+	var out strings.Builder
+	err := run([]string{"redeem", "-execute", "-token-file", path}, strings.NewReader(`{"gift_key":"giftkey","gift_code":"giftcode","request_id":"stable-2"}`), &out, f)
+	if err != nil || f.calls != 1 || f.token != "official-token" || !strings.Contains(out.String(), `"flow_no":"flow"`) || !strings.Contains(out.String(), `"credits":7`) || strings.Contains(out.String(), "official-token") || strings.Contains(out.String(), "secret-open-id") {
+		t.Fatalf("err=%v out=%q calls=%d token=%q", err, out.String(), f.calls, f.token)
+	}
+}
+
+func TestRedeemRejectsUnknownTrailingAndOversizedInput(t *testing.T) {
+	for _, input := range []string{`{"code":"code","request_id":"stable-1","extra":1}`, `{"code":"code","request_id":"stable-1"}{}`, strings.Repeat("x", maxInput+1)} {
+		f := &fakeRedeemer{}
+		if err := run([]string{"redeem"}, strings.NewReader(input), &strings.Builder{}, f); err == nil || f.calls != 0 {
+			t.Fatalf("input accepted or called client: err=%v calls=%d", err, f.calls)
+		}
+	}
+}
+
+func TestRedeemTokenFilePermissionsAndExecuteRequirement(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "token.json")
+	if err := os.WriteFile(path, []byte(`{"access_token":"secret"}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := run([]string{"redeem", "-execute", "-token-file", path}, strings.NewReader(`{"code":"code","request_id":"stable-1"}`), &strings.Builder{}, &fakeRedeemer{}); err == nil {
+		t.Fatal("permissive token file accepted")
+	}
+	if err := run([]string{"redeem", "-execute"}, strings.NewReader(`{"code":"code","request_id":"stable-1"}`), &strings.Builder{}, &fakeRedeemer{}); err == nil {
+		t.Fatal("missing token file accepted")
+	}
+}
diff --git a/cmd/openapi/oauth_commands.go b/cmd/openapi/oauth_commands.go
new file mode 100644
index 0000000..b7d5b82
--- /dev/null
+++ b/cmd/openapi/oauth_commands.go
@@ -0,0 +1,197 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"io"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/linguo2625469/workbuddy2api-panel/internal/workbuddyopen"
+)
+
+const (
+	oauthScope   = "user.credit.exchange"
+	maxOAuthFile = 64 << 10
+	oauthMaxAge  = 15 * time.Minute
+)
+
+type oauthSession struct {
+	ClientID    string    `json:"client_id"`
+	RedirectURI string    `json:"redirect_uri"`
+	State       string    `json:"state"`
+	CreatedAt   time.Time `json:"created_at"`
+}
+
+type oauthCallback struct {
+	Code  string `json:"code"`
+	State string `json:"state"`
+}
+
+func runAuthorize(args []string, out io.Writer, client *workbuddyopen.Client) error {
+	fs := newOAuthFlagSet("authorize")
+	clientID := fs.String("client-id", "", "official OAuth client id")
+	redirectURI := fs.String("redirect-uri", "", "registered redirect URI")
+	statePath := fs.String("state-file", "", "state session file")
+	if err := fs.Parse(args); err != nil || fs.NArg() != 0 {
+		return errors.New("authorize: invalid arguments")
+	}
+	if strings.TrimSpace(*clientID) == "" || strings.TrimSpace(*redirectURI) == "" || strings.TrimSpace(*statePath) == "" {
+		return errors.New("authorize: -client-id, -redirect-uri and -state-file are required")
+	}
+	state, err := workbuddyopen.NewState()
+	if err != nil {
+		return errors.New("authorize: could not create state")
+	}
+	url, err := client.AuthorizeURL(*clientID, *redirectURI, oauthScope, state)
+	if err != nil {
+		return errors.New("authorize: invalid OAuth parameters")
+	}
+	session := oauthSession{ClientID: *clientID, RedirectURI: *redirectURI, State: state, CreatedAt: time.Now().UTC()}
+	if err := createJSON0600(*statePath, session); err != nil {
+		return errors.New("authorize: state file unavailable")
+	}
+	_, err = io.WriteString(out, url+"\n")
+	return err
+}
+
+func runExchange(args []string, stdin io.Reader, out io.Writer, client *workbuddyopen.Client) error {
+	fs := newOAuthFlagSet("exchange")
+	statePath := fs.String("state-file", "", "state session file")
+	tokenPath := fs.String("token-file", "", "token output file")
+	if err := fs.Parse(args); err != nil || fs.NArg() != 0 {
+		return errors.New("exchange: invalid arguments")
+	}
+	if strings.TrimSpace(*statePath) == "" || strings.TrimSpace(*tokenPath) == "" {
+		return errors.New("exchange: -state-file and -token-file are required")
+	}
+	callback, err := decodeOAuthCallback(stdin)
+	if err != nil {
+		return err
+	}
+	session, err := readOAuthSession(*statePath)
+	if err != nil {
+		return errors.New("exchange: state file unavailable")
+	}
+	now := time.Now().UTC()
+	if session.CreatedAt.After(now) || now.Sub(session.CreatedAt) > oauthMaxAge {
+		return errors.New("exchange: state expired")
+	}
+	if !workbuddyopen.VerifyState(session.State, callback.State) {
+		return errors.New("exchange: state mismatch")
+	}
+	secret := os.Getenv("WORKBUDDY_OPEN_CLIENT_SECRET")
+	if strings.TrimSpace(secret) == "" {
+		return errors.New("exchange: client secret is required")
+	}
+	// Refuse an existing destination before consuming the one-use code.
+	if _, err := os.Lstat(*tokenPath); !os.IsNotExist(err) {
+		return errors.New("exchange: token destination already exists or is unavailable")
+	}
+	// Claim this session once before submitting the one-use authorization code.
+	// An uncertain network/save failure requires a new authorization flow, never
+	// an automatic replay with a different destination file.
+	if err := createJSON0600(*statePath+".used", map[string]bool{"submitted": true}); err != nil {
+		return errors.New("exchange: session already submitted; start a new authorization flow")
+	}
+	token, err := client.ExchangeCode(context.Background(), session.ClientID, secret, callback.Code, session.RedirectURI)
+	if err != nil {
+		return errors.New("exchange: token exchange failed")
+	}
+	if err := createJSON0600(*tokenPath, tokenDocument{OAuthToken: *token, ObtainedAt: time.Now().UTC()}); err != nil {
+		return errors.New("exchange: token file unavailable")
+	}
+	if err := os.Remove(*statePath); err != nil {
+		_, err = io.WriteString(out, "token saved; state cleanup pending; do not exchange again\n")
+		return err
+	}
+	_ = os.Remove(*statePath + ".used") // state no longer exists; marker cleanup is best effort.
+	_, err = io.WriteString(out, "token saved\n")
+	return err
+}
+
+func newOAuthFlagSet(name string) *flag.FlagSet {
+	fs := flag.NewFlagSet(name, flag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	return fs
+}
+
+func decodeOAuthCallback(r io.Reader) (oauthCallback, error) {
+	b, err := io.ReadAll(io.LimitReader(r, maxOAuthFile+1))
+	if err != nil || len(b) > maxOAuthFile {
+		return oauthCallback{}, errors.New("exchange: invalid callback input")
+	}
+	dec := json.NewDecoder(strings.NewReader(string(b)))
+	dec.DisallowUnknownFields()
+	var callback oauthCallback
+	if err := dec.Decode(&callback); err != nil {
+		return callback, errors.New("exchange: callback must be one JSON object")
+	}
+	var extra any
+	if err := dec.Decode(&extra); err != io.EOF {
+		return callback, errors.New("exchange: trailing JSON is not allowed")
+	}
+	if strings.TrimSpace(callback.Code) == "" || strings.TrimSpace(callback.State) == "" {
+		return callback, errors.New("exchange: code and state are required")
+	}
+	return callback, nil
+}
+
+func createJSON0600(path string, value any) error {
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return err
+	}
+	ok := false
+	defer func() {
+		if !ok {
+			_ = f.Close()
+			_ = os.Remove(path)
+		}
+	}()
+	if err := json.NewEncoder(f).Encode(value); err != nil {
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	ok = true
+	return nil
+}
+
+func readOAuthSession(path string) (oauthSession, error) {
+	var session oauthSession
+	info, err := os.Lstat(path)
+	if err != nil || info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || info.Mode().Perm() != 0600 {
+		return session, errors.New("invalid session file")
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return session, err
+	}
+	defer f.Close()
+	opened, err := f.Stat()
+	if err != nil || !os.SameFile(info, opened) {
+		return session, errors.New("session changed")
+	}
+	b, err := io.ReadAll(io.LimitReader(f, maxOAuthFile+1))
+	if err != nil || len(b) > maxOAuthFile {
+		return session, errors.New("session unreadable")
+	}
+	dec := json.NewDecoder(strings.NewReader(string(b)))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&session); err != nil {
+		return session, err
+	}
+	var extra any
+	if err := dec.Decode(&extra); err != io.EOF {
+		return session, errors.New("trailing session JSON")
+	}
+	if session.ClientID == "" || session.RedirectURI == "" || session.State == "" || session.CreatedAt.IsZero() {
+		return session, errors.New("incomplete session")
+	}
+	return session, nil
+}
