new file mode 100644
index 0000000..af25d4e
--- /dev/null
+++ b/AGENTS.md
@@ -0,0 +1,11 @@
+# Project maintenance workflow
+
+- Coordinator owns requirements, scope, architecture decisions, integration, acceptance, and final reporting.
+- Delegate bounded implementation to `implementer`; use `repo_explorer`, `test_engineer`, `reviewer`, `security_reviewer`, and `docs_release` for their configured roles. Preserve project-local model settings; never modify global Codex configuration.
+- Delegate read-only investigations in parallel. Assign explicit file ownership before writes; agents must not revert other agents' work. Coordinate overlapping changes serially.
+- Save milestones and outstanding work in `maintenance/ROADMAP.txt`. Keep routine progress in files; notify the user only for delivery, terminal failure, or a decision that actually requires their input.
+- Before acceptance run `bash scripts/verify.sh`, inspect the diff, and obtain independent review. Report actual commands and exit codes, not unexecuted expectations.
+- Keep fixes in small reversible Git commits. Do not push main, create release tags, or publish images automatically; use a maintenance branch and an integration PR.
+- New upstream integrations require a current official contract and an explicit opt-in path. Keep Open API OAuth tokens separate from legacy client credentials. Never invent account progress, bypass enforcement, or represent legacy/private endpoints as officially supported.
+- No live account or reward mutation in automated tests. Use deterministic fixtures; never commit/log tokens, redemption codes, real account records, or personal request payloads.
+- Use `uv` for Python tooling/execution, `fnm` for Node environments, and `jenv` for Java environments when needed.
diff --git a/cmd/server/startup.go b/cmd/server/startup.go
new file mode 100644
index 0000000..b2f6b8d
--- /dev/null
+++ b/cmd/server/startup.go
@@ -0,0 +1,24 @@
+package main
+
+import (
+	"errors"
+	"io/fs"
+)
+
+// loadStartupConfig loads the configured file, creating the secure default only
+// when the path is missing. A failure to create or reload that file is fatal:
+// falling back to Load("") could otherwise start an unauthenticated listener.
+// An empty path intentionally retains Load's env-only semantics.
+func loadStartupConfig(path string) (*Config, error) {
+	cfg, err := Load(path)
+	if err == nil {
+		return cfg, nil
+	}
+	if path == "" || !errors.Is(err, fs.ErrNotExist) {
+		return nil, err
+	}
+	if _, writeErr := WriteDefault(path); writeErr != nil {
+		return nil, writeErr
+	}
+	return Load(path)
+}
diff --git a/cmd/server/startup_test.go b/cmd/server/startup_test.go
new file mode 100644
index 0000000..98a7f8a
--- /dev/null
+++ b/cmd/server/startup_test.go
@@ -0,0 +1,81 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestLoadStartupConfigCreatesMissingFile(t *testing.T) {
+	t.Setenv("WB2A_API_KEY", "")
+	path := filepath.Join(t.TempDir(), "config.json")
+	cfg, err := loadStartupConfig(path)
+	if err != nil {
+		t.Fatalf("loadStartupConfig: %v", err)
+	}
+	if cfg.APIKey == "" {
+		t.Fatal("generated config must have an api key")
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("generated config missing: %v", err)
+	}
+}
+
+func TestLoadStartupConfigFailsClosedWhenDefaultWriteFails(t *testing.T) {
+	parent := filepath.Join(t.TempDir(), "parent-file")
+	if err := os.WriteFile(parent, []byte("not a directory"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	_, err := loadStartupConfig(filepath.Join(parent, "config.json"))
+	if err == nil {
+		t.Fatal("expected default-write failure")
+	}
+}
+
+func TestLoadStartupConfigPreservesExistingAndEnvOverride(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.json")
+	original := `{"api_key":"file-key","listen":":9001"}`
+	if err := os.WriteFile(path, []byte(original), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("WB2A_API_KEY", "env-key")
+	cfg, err := loadStartupConfig(path)
+	if err != nil {
+		t.Fatalf("loadStartupConfig: %v", err)
+	}
+	if cfg.APIKey != "env-key" || cfg.Listen != ":9001" {
+		t.Fatalf("cfg=%+v", cfg)
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil || string(raw) != original {
+		t.Fatalf("existing config changed: %q (%v)", raw, err)
+	}
+}
+
+func TestLoadStartupConfigMalformedFileIsNotOverwritten(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.json")
+	original := "{malformed"
+	if err := os.WriteFile(path, []byte(original), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	_, err := loadStartupConfig(path)
+	if err == nil || !strings.Contains(err.Error(), "parse config") {
+		t.Fatalf("err=%v want parse error", err)
+	}
+	raw, readErr := os.ReadFile(path)
+	if readErr != nil || string(raw) != original {
+		t.Fatalf("malformed config changed: %q (%v)", raw, readErr)
+	}
+}
+
+func TestLoadStartupConfigEmptyPathUsesEnvironment(t *testing.T) {
+	t.Setenv("WB2A_API_KEY", "env-only-key")
+	cfg, err := loadStartupConfig("")
+	if err != nil {
+		t.Fatalf("loadStartupConfig: %v", err)
+	}
+	if cfg.APIKey != "env-only-key" {
+		t.Fatalf("api_key=%q want env-only-key", cfg.APIKey)
+	}
+}
