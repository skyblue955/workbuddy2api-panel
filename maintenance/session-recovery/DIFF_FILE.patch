diff --git a/internal/panel/login_reauthorization_test.go b/internal/panel/login_reauthorization_test.go
new file mode 100644
index 0000000..2b5a146
--- /dev/null
+++ b/internal/panel/login_reauthorization_test.go
@@ -0,0 +1,334 @@
+package panel
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
