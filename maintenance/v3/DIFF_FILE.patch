diff --git a/internal/panel/claimready.go b/internal/panel/claimready.go
new file mode 100644
index 0000000..3f9054c
--- /dev/null
+++ b/internal/panel/claimready.go
@@ -0,0 +1,232 @@
+package panel
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+
+	"github.com/linguo2625469/workbuddy2api-panel/internal/upstream"
+)
+
+type claimReadyRequest struct {
+	TaskCodes []string `json:"task_codes"`
+	Execute   bool     `json:"execute"`
+}
+
+type claimReadyResult struct {
+	TaskCode              string `json:"task_code"`
+	Status                string `json:"status"`
+	Reason                string `json:"reason,omitempty"`
+	RewardReceived        bool   `json:"reward_received"`
+	ReceiptRewardReported bool   `json:"receipt_reward_reported"`
+	UpstreamClaimed       bool   `json:"upstream_claimed"`
+	Credit                int64  `json:"credit,omitempty"`
+	Energy                int64  `json:"energy,omitempty"`
+}
+
+func parseClaimReadyRequest(r io.Reader) (claimReadyRequest, error) {
+	var req claimReadyRequest
+	b, err := io.ReadAll(io.LimitReader(r, 8*1024+1))
+	if err != nil || len(b) > 8*1024 {
+		return req, errors.New("request too large")
+	}
+	dec := json.NewDecoder(bytes.NewReader(b))
+	token, err := dec.Token()
+	if err != nil || token != json.Delim('{') {
+		return req, errors.New("invalid shape")
+	}
+	raw := map[string]json.RawMessage{}
+	for dec.More() {
+		token, err := dec.Token()
+		if err != nil {
+			return req, errors.New("invalid field")
+		}
+		key, ok := token.(string)
+		if !ok || (key != "task_codes" && key != "execute") {
+			return req, errors.New("unknown field")
+		}
+		if _, duplicate := raw[key]; duplicate {
+			return req, errors.New("duplicate field")
+		}
+		var value json.RawMessage
+		if err := dec.Decode(&value); err != nil {
+			return req, errors.New("invalid field")
+		}
+		raw[key] = value
+	}
+	if token, err = dec.Token(); err != nil || token != json.Delim('}') {
+		return req, errors.New("invalid shape")
+	}
+	v, ok := raw["task_codes"]
+	if !ok || string(v) == "null" || json.Unmarshal(v, &req.TaskCodes) != nil {
+		return req, errors.New("task_codes")
+	}
+	if v, ok = raw["execute"]; ok {
+		if string(v) == "null" || json.Unmarshal(v, &req.Execute) != nil {
+			return req, errors.New("execute")
+		}
+	}
+	var extra any
+	if err := dec.Decode(&extra); err == nil || !errors.Is(err, io.EOF) {
+		return req, io.ErrUnexpectedEOF
+	}
+	return req, nil
+}
+
+// accountTasksClaimReady claims only explicitly requested, already-ready tasks.
+// It deliberately uses the default task list and never performs task actions.
+func (p *Panel) accountTasksClaimReady(w http.ResponseWriter, r *http.Request) {
+	uid := r.PathValue("uid")
+	a := p.cfg.Pool.AuthByUID(uid)
+	if a == nil {
+		writeErr(w, http.StatusNotFound, "account not found")
+		return
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 8*1024)
+	req, err := parseClaimReadyRequest(r.Body)
+	if err != nil {
+		writeErr(w, http.StatusBadRequest, "invalid request")
+		return
+	}
+	if len(req.TaskCodes) < 1 || len(req.TaskCodes) > 10 {
+		writeErr(w, http.StatusBadRequest, "task_codes must contain 1..10 codes")
+		return
+	}
+	seen := make(map[string]bool, len(req.TaskCodes))
+	for _, code := range req.TaskCodes {
+		if strings.TrimSpace(code) == "" || seen[code] {
+			writeErr(w, http.StatusBadRequest, "task_codes contains invalid code")
+			return
+		}
+		seen[code] = true
+	}
+	if !p.tryLockAccount(uid) {
+		writeErr(w, http.StatusConflict, "account task operation is busy")
+		return
+	}
+	defer p.unlockAccount(uid)
+
+	results := make([]claimReadyResult, 0, len(req.TaskCodes))
+	if a.IsGlobal() || a.IsEnterprise() {
+		writeJSON(w, http.StatusUnprocessableEntity, map[string]any{"ok": false, "support": "legacy_unverified", "error": "unsupported account"})
+		return
+	}
+	tasks, err := p.cfg.Upstream.ListTasks(a)
+	if err != nil {
+		writeErr(w, http.StatusBadGateway, "list tasks failed")
+		return
+	}
+	byCode := make(map[string][]upstream.Task)
+	for _, t := range tasks {
+		byCode[t.TaskCode] = append(byCode[t.TaskCode], t)
+	}
+	eligible := make(map[string]bool)
+	for _, code := range req.TaskCodes {
+		entries := byCode[code]
+		if len(entries) != 1 {
+			reason := "missing_task"
+			if len(entries) > 1 {
+				reason = "ambiguous_task"
+			}
+			results = append(results, claimReadyResult{TaskCode: code, Status: "skipped", Reason: reason})
+			continue
+		}
+		t := entries[0]
+		status := strings.ToLower(strings.TrimSpace(t.Status))
+		reason := ""
+		switch {
+		case isMPTaskCode(code):
+			reason = "unsupported_channel"
+		case t.Claimed:
+			reason = "already_claimed"
+		case t.Locked:
+			reason = "locked"
+		case t.RewardBuddy:
+			reason = "buddy_side_effect_not_authorized"
+		case status == "expired" || status == "ended" || status == "disabled" || status == "cancelled":
+			reason = "inactive_task"
+		case t.Target <= 0:
+			reason = "progress_unknown"
+		case t.Current < t.Target || !t.Claimable:
+			reason = "not_ready"
+		}
+		if reason != "" {
+			results = append(results, claimReadyResult{TaskCode: code, Status: "skipped", Reason: reason, UpstreamClaimed: t.Claimed})
+			continue
+		}
+		eligible[code] = true
+		results = append(results, claimReadyResult{TaskCode: code, Status: "selected"})
+	}
+	if !req.Execute {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": true, "support": "legacy_unverified", "selected": len(eligible), "readiness": len(eligible), "claims": 0, "results": results})
+		return
+	}
+	claims := 0
+	if len(eligible) == 0 {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": true, "complete": true, "no_op": true, "support": "legacy_unverified", "selected": 0, "readiness": 0, "claims": 0, "results": results})
+		return
+	}
+	uncertain := false
+	for i := range results {
+		if !eligible[results[i].TaskCode] {
+			continue
+		}
+		claims++
+		credit, energy, claimErr := p.cfg.Upstream.ClaimReward(a, results[i].TaskCode)
+		if claimErr == nil {
+			if credit < 0 || energy < 0 {
+				results[i].Status = "uncertain"
+				uncertain = true
+			} else {
+				results[i].Status = "submitted"
+				results[i].ReceiptRewardReported = credit > 0 || energy > 0
+				results[i].Credit, results[i].Energy = credit, energy
+			}
+		} else {
+			results[i].Status = "uncertain"
+			uncertain = true
+		}
+	}
+	// One and only one post-write default-list confirmation.
+	if confirmed, listErr := p.cfg.Upstream.ListTasks(a); listErr == nil {
+		for i := range results {
+			if results[i].Status != "submitted" && results[i].Status != "uncertain" {
+				continue
+			}
+			matches := 0
+			claimed := false
+			for _, t := range confirmed {
+				if t.TaskCode == results[i].TaskCode {
+					matches++
+					claimed = claimed || t.Claimed
+				}
+			}
+			if matches == 1 && claimed {
+				results[i].UpstreamClaimed = true
+				if results[i].Status == "submitted" {
+					results[i].Status = "confirmed"
+					results[i].RewardReceived = results[i].ReceiptRewardReported
+				} else {
+					results[i].Status = "claimed_outcome_uncertain"
+				}
+			} else {
+				if results[i].Status == "submitted" {
+					results[i].Status = "submitted_unverified"
+				}
+				uncertain = true
+			}
+		}
+	} else {
+		uncertain = true
+		for i := range results {
+			if results[i].Status == "submitted" {
+				results[i].Status = "submitted_unverified"
+			}
+		}
+	}
+	complete := !uncertain
+	writeJSON(w, http.StatusOK, map[string]any{"ok": complete, "complete": complete, "support": "legacy_unverified", "selected": len(eligible), "readiness": len(eligible), "claims": claims, "results": results})
+}
diff --git a/internal/panel/claimready_safety_test.go b/internal/panel/claimready_safety_test.go
new file mode 100644
index 0000000..fbdf9a2
--- /dev/null
+++ b/internal/panel/claimready_safety_test.go
@@ -0,0 +1,223 @@
+package panel
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/linguo2625469/workbuddy2api-panel/internal/auth"
+	"github.com/linguo2625469/workbuddy2api-panel/internal/pool"
+	"github.com/linguo2625469/workbuddy2api-panel/internal/upstream"
+)
+
+type claimRT struct {
+	mu          sync.Mutex
+	lists       [][]upstream.Task
+	claimStatus int
+	negative    bool
+	calls       []string
+}
+
+func (x *claimRT) RoundTrip(r *http.Request) (*http.Response, error) {
+	x.mu.Lock()
+	defer x.mu.Unlock()
+	x.calls = append(x.calls, r.Method+" "+r.URL.Path)
+	if r.URL.Path == "/v2/activity/growth/tasks" {
+		if len(x.lists) == 0 {
+			return nil, errors.New("unexpected list")
+		}
+		ts := x.lists[0]
+		x.lists = x.lists[1:]
+		b, _ := json.Marshal(map[string]any{"code": 0, "data": map[string]any{"tasks": ts}})
+		return resp(200, b), nil
+	}
+	if strings.HasSuffix(r.URL.Path, "/claim") {
+		if x.claimStatus != 0 {
+			return resp(x.claimStatus, []byte(`{"code":1,"msg":"failed"}`)), nil
+		}
+		if x.negative {
+			return resp(200, []byte(`{"code":0,"data":{"credit":-1,"energy":1}}`)), nil
+		}
+		return resp(200, []byte(`{"code":0,"data":{"credit":10,"energy":1}}`)), nil
+	}
+	return nil, errors.New("unexpected endpoint")
+}
+func resp(code int, b []byte) *http.Response {
+	return &http.Response{StatusCode: code, Status: http.StatusText(code), Body: io.NopCloser(bytes.NewReader(b)), Header: make(http.Header)}
+}
+func claimSafetyPanel(rt *claimRT, a *auth.Auth) *Panel {
+	q := pool.New("")
+	q.Add(a)
+	cl := &upstream.Client{HTTP: &http.Client{Transport: rt}, ChatBaseCN: "http://fixture", BillingBaseCN: "http://fixture", WebBaseCN: "http://fixture"}
+	return New(Config{Pool: q, APIKey: "k", Upstream: cl})
+}
+func safetyCall(p *Panel, method, path, body string) (int, map[string]any) {
+	r := httptest.NewRequest(method, path, strings.NewReader(body))
+	r.Header.Set("Authorization", "Bearer k")
+	w := httptest.NewRecorder()
+	p.ServeHTTP(w, r)
+	var m map[string]any
+	_ = json.Unmarshal(w.Body.Bytes(), &m)
+	return w.Code, m
+}
+func st(c string, cur, target int64) upstream.Task {
+	return upstream.Task{TaskCode: c, Current: cur, Target: target, Claimable: cur >= target && target > 0}
+}
+func TestClaimReadySafetyParserAndZeroOutbound(t *testing.T) {
+	cases := []string{`null`, `[]`, `{"task_codes":null}`, `{"task_codes":["x"],"execute":null}`, `{"task_codes":["x"],"execute":1}`, `{"task_codes":["x"]}{}`, `{"task_codes":["x"],"task_codes":["y"]}`, `{"task_codes":["x"],"execute":false,"execute":true}`, `{"task_codes":["x"],"extra":1}`, `{"task_codes":["x"]}` + strings.Repeat(" ", 8193)}
+	for _, body := range cases {
+		rt := &claimRT{}
+		p := claimSafetyPanel(rt, &auth.Auth{UID: "u1", AccessToken: "fixture"})
+		code, _ := safetyCall(p, "POST", "/panel/api/accounts/u1/tasks/claim_ready", body)
+		if code != 400 || len(rt.calls) != 0 {
+			t.Fatalf("invalid body length%d code%d calls%v", len(body), code, rt.calls)
+		}
+	}
+}
+func TestClaimReadySafetyFiltersAndSingleClaim(t *testing.T) {
+	rt := &claimRT{lists: [][]upstream.Task{{st("new_code", 1, 1), st("other", 1, 1), {TaskCode: "buddy", Current: 1, Target: 1, Claimable: true, RewardBuddy: true}, {TaskCode: "expired", Current: 1, Target: 1, Claimable: true, Status: "expired"}, {TaskCode: "Sequential_Tasks_1", Current: 1, Target: 1, Claimable: true}, {TaskCode: "zero", Current: 0, Target: 0, Claimable: true}, {TaskCode: "dup", Current: 1, Target: 1, Claimable: true}, {TaskCode: "dup", Current: 1, Target: 1, Claimable: true}}, {func() upstream.Task { x := st("new_code", 1, 1); x.AcceptStatus = "claimed"; return x }()}}}
+	p := claimSafetyPanel(rt, &auth.Auth{UID: "u1", AccessToken: "a"})
+	c, m := safetyCall(p, "POST", "/panel/api/accounts/u1/tasks/claim_ready", `{"task_codes":["new_code","buddy","expired","Sequential_Tasks_1","zero","dup","missing"],"execute":true}`)
+	if c != 200 || m["claims"] != float64(1) || m["ok"] != true {
+		t.Fatalf("%d %v", c, m)
+	}
+	rt.mu.Lock()
+	defer rt.mu.Unlock()
+	if len(rt.calls) != 3 || rt.calls[1] != "POST /activity/growth/tasks/new_code/claim" {
+		t.Fatalf("calls=%v", rt.calls)
+	}
+}
+func TestClaimReadySafetyReceiptAndReadFailures(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		lists  [][]upstream.Task
+		status int
+		wantOK bool
+	}{{"duplicate confirmation", [][]upstream.Task{{st("x", 1, 1)}, {st("x", 1, 1), st("x", 1, 1)}}, 0, false}, {"unclaimed confirmation", [][]upstream.Task{{st("x", 1, 1)}, {st("x", 1, 1)}}, 0, false}, {"negative receipt", [][]upstream.Task{{st("x", 1, 1)}, {func() upstream.Task { x := st("x", 1, 1); x.AcceptStatus = "claimed"; return x }()}}, 0, false}, {"post-read failure", [][]upstream.Task{{st("x", 1, 1)}}, 0, false}} {
+		rt := &claimRT{lists: tc.lists, claimStatus: tc.status, negative: tc.name == "negative receipt"}
+		if tc.name == "post-read failure" {
+			rt.lists = [][]upstream.Task{{st("x", 1, 1)}}
+		}
+		p := claimSafetyPanel(rt, &auth.Auth{UID: "u1", AccessToken: "a"})
+		_, m := safetyCall(p, "POST", "/panel/api/accounts/u1/tasks/claim_ready", `{"task_codes":["x"],"execute":true}`)
+		if m["ok"] == true && !tc.wantOK {
+			t.Errorf("%s unexpectedly ok: %v", tc.name, m)
+		}
+		if m["ok"] == false && tc.wantOK {
+			t.Errorf("%s unexpectedly failed: %v", tc.name, m)
+		}
+	}
+}
+func TestClaimReadySafetySourceHintAndSharedLock(t *testing.T) {
+	raw, _ := json.Marshal(map[string]any{"accessToken": enterpriseSwitchToken(), "uid": "u1", "domain": "copilot.tencent.com"})
+	a, e := auth.Parse(raw)
+	if e != nil || a.IsEnterprise() || !a.HasEnterpriseSwitchSource() {
+		t.Fatalf("source hint fixture: %v %v", a, e)
+	}
+	rt := &claimRT{lists: [][]upstream.Task{{st("new_code", 1, 1)}}}
+	p := claimSafetyPanel(rt, a)
+	p.tryLockAccount("u1")
+	for _, path := range []string{"/panel/api/accounts/u1/tasks/accept", "/panel/api/accounts/u1/tasks/accept_all", "/panel/api/accounts/u1/tasks/claim"} {
+		c, _ := safetyCall(p, "POST", path, `{"task_codes":["x"],"task_code":"x"}`)
+		if c != 409 {
+			t.Errorf("%s=%d", path, c)
+		}
+	}
+	rt.mu.Lock()
+	if len(rt.calls) != 0 {
+		t.Errorf("locked outbound=%v", rt.calls)
+	}
+	rt.mu.Unlock()
+	p.unlockAccount("u1")
+	code, m := safetyCall(p, "POST", "/panel/api/accounts/u1/tasks/claim_ready", `{"task_codes":["new_code"]}`)
+	if code != 200 || m["selected"] != float64(1) || m["claims"] != float64(0) || len(rt.calls) != 1 {
+		t.Fatalf("sourcehint dryrun code%d result%v calls%v", code, m, rt.calls)
+	}
+}
+
+func TestClaimReadySafetyNoopAndClaimFailureBudget(t *testing.T) {
+	for _, ready := range []bool{false, true} {
+		var lists [][]upstream.Task
+		if ready {
+			lists = [][]upstream.Task{{st("x", 1, 1)}, {st("x", 1, 1)}}
+		} else {
+			lists = [][]upstream.Task{{st("x", 0, 1)}}
+		}
+		rt := &claimRT{lists: lists, claimStatus: 502}
+		p := claimSafetyPanel(rt, &auth.Auth{UID: "u1", AccessToken: "fixture"})
+		code, m := safetyCall(p, "POST", "/panel/api/accounts/u1/tasks/claim_ready", `{"task_codes":["x"],"execute":true}`)
+		if code != 200 {
+			t.Fatalf("http%d", code)
+		}
+		writes := 0
+		for _, c := range rt.calls {
+			if strings.HasPrefix(c, "POST ") {
+				writes++
+			}
+		}
+		if !ready {
+			if m["no_op"] != true || writes != 0 || len(rt.calls) != 1 {
+				t.Fatalf("notready mutated %v calls%v", m, rt.calls)
+			}
+		} else {
+			if m["ok"] != false || m["complete"] != false || m["claims"] != float64(1) || writes != 1 || len(rt.calls) != 3 {
+				t.Fatalf("failed claim/retry %v calls%v", m, rt.calls)
+			}
+		}
+	}
+}
+func TestClaimReadySafetyRewardConfirmationFields(t *testing.T) {
+	for _, kind := range []string{"confirmed", "notclaimed", "duplicate", "readerror", "negative"} {
+		done := st("x", 1, 1)
+		done.AcceptStatus = "claimed"
+		lists := [][]upstream.Task{{st("x", 1, 1)}}
+		switch kind {
+		case "confirmed", "negative":
+			lists = append(lists, []upstream.Task{done})
+		case "notclaimed":
+			lists = append(lists, []upstream.Task{st("x", 1, 1)})
+		case "duplicate":
+			lists = append(lists, []upstream.Task{done, done})
+		}
+		rt := &claimRT{lists: lists, negative: kind == "negative"}
+		p := claimSafetyPanel(rt, &auth.Auth{UID: "u1", AccessToken: "fixture"})
+		_, m := safetyCall(p, "POST", "/panel/api/accounts/u1/tasks/claim_ready", `{"task_codes":["x"],"execute":true}`)
+		r := m["results"].([]any)[0].(map[string]any)
+		if kind == "confirmed" {
+			if r["reward_received"] != true || r["upstream_claimed"] != true || r["credit"] != float64(10) || m["complete"] != true {
+				t.Fatalf("confirmed%v", m)
+			}
+		} else {
+			if r["reward_received"] != false || m["complete"] != false {
+				t.Fatalf("false reward confirmation %s %v", kind, m)
+			}
+		}
+		if r["receipt_reward_reported"] != (kind != "negative") {
+			t.Fatalf("receiptflag%s %v", kind, m)
+		}
+		if len(rt.calls) != 3 {
+			t.Fatalf("unexpectedcalls %v", rt.calls)
+		}
+	}
+}
+
+func TestClaimReadySafetyAlreadyClaimedSnapshot(t *testing.T) {
+	done := st("x", 1, 1)
+	done.AcceptStatus = "claimed"
+	rt := &claimRT{lists: [][]upstream.Task{{done}}}
+	p := claimSafetyPanel(rt, &auth.Auth{UID: "u1", AccessToken: "fixture"})
+	code, m := safetyCall(p, "POST", "/panel/api/accounts/u1/tasks/claim_ready", `{"task_codes":["x"]}`)
+	if code != 200 || m["claims"] != float64(0) || len(rt.calls) != 1 {
+		t.Fatalf("unexpected calls %v %v", m, rt.calls)
+	}
+	r := m["results"].([]any)[0].(map[string]any)
+	if r["reason"] != "already_claimed" || r["upstream_claimed"] != true || r["reward_received"] != false {
+		t.Fatalf("contradictory claimed snapshot %v", r)
+	}
+}
diff --git a/internal/panel/claimready_test.go b/internal/panel/claimready_test.go
